# Copy this file to .env. Never paste keys into chat or commit .env.
PORT=3000

# Apple Music: use a developer token OR a MusicKit .p8 signing key.
APPLE_MUSIC_DEVELOPER_TOKEN=
APPLE_MUSIC_TEAM_ID=
APPLE_MUSIC_KEY_ID=
APPLE_MUSIC_PRIVATE_KEY_PATH=
APPLE_MUSIC_STOREFRONT=us

# Spotify application: server-side Client Credentials, not a user login.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_MARKET=US

# Genius: Generate Access Token at https://genius.com/api-clients
GENIUS_ACCESS_TOKEN=
# Optional: path to a manually verified Genius daily artist-chart snapshot.
# Blank uses data/genius-artist-chart.json; snapshots expire after 24 hours.
# The official API does not expose search rankings or an artist-chart feed.
GENIUS_ARTIST_CHART_FILE=

# MusicBrainz needs no key. Add your real contact address before sharing the app.
MUSICBRAINZ_USER_AGENT="Artistree/0.2.0 (local non-commercial music discovery)"

# Dedicated Artistree Supabase project. Only a modern publishable key is accepted.
# The publishable-key field must never contain sb_secret_*, service_role or OAuth secrets.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Enable each only AFTER provider setup and callback testing in that project.
# Comma-separated: google,kakao,naver. Naver uses the server adapter below.
ARTISTREE_AUTH_PROVIDERS=
ARTISTREE_NAVER_ADAPTER_VERIFIED=false
# Canonical HTTPS origin on Vercel; leave blank locally.
PUBLIC_APP_ORIGIN=
# Naver app credentials stay on the server; the adapter needs a stable HTTPS origin.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# Random 32+ byte base64url secret, also set as custom:naver's Supabase Client Secret.
NAVER_ADAPTER_SECRET=
